# Copie este arquivo para ".env" e preencha os valores.
# NUNCA faça commit do arquivo ".env" de verdade (ele já está no .gitignore).

# Chaves usadas para assinar cookies/tokens. Troque por valores aleatórios.
SECRET_KEY=troque-por-uma-string-aleatoria
JWT_SECRET_KEY=troque-por-outra-string-aleatoria

# Banco de dados.
# Em desenvolvimento, deixe assim (cria um arquivo dev.db local em SQLite):
DATABASE_URL=sqlite:///dev.db
# Em produção (Render), a plataforma fornece uma DATABASE_URL de Postgres
# automaticamente ao conectar o banco ao serviço web.

# Chave da API pública do TMDB (The Movie Database).
# Crie uma conta gratuita em https://www.themoviedb.org/signup,
# depois vá em Configurações > API e gere uma "API Key (v3 auth)".
TMDB_API_KEY=coloque_sua_chave_aqui

# Origens (frontend) autorizadas a chamar esta API, separadas por vírgula.
# Durante o desenvolvimento local, inclua a porta do seu Live Server/servidor estático.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Horas de validade do token de login (JWT).
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
